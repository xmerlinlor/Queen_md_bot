# ╔══════════════════════════════════════╗
# ║          👑 QUEEN MD                ║
# ║      ENVIRONMENT CONFIGURATION      ║
# ╚══════════════════════════════════════╝

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🤖 BOT INFORMATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
BOT_NAME=Queen MD
BOT_VERSION=1.0.0
PREFIX=.
DESCRIPTION=Queen MD Mini WhatsApp Bot with Telegram pairing

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 👑 OWNER CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OWNER_NUMBER=234XXXXXXXXXX
OWNER_NAME=Queen MD Admin

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📲 TELEGRAM CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get your token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📱 WHATSAPP CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SESSION_NAME=queen-md-session
WHATSAPP_TIMEOUT=60000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚙️ BOT SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MODE=public
AUTO_REPLY=false
AUTO_READ=true
AUTO_TYPING=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🗄️ DATABASE CONFIGURATION (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MONGODB_URI=
DB_NAME=queen_md
ENABLE_DATABASE=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📊 LOGGING CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LOG_LEVEL=info
DEBUG=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 ENVIRONMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NODE_ENV=production

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⏱️ TIMEOUTS & LIMITS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MESSAGE_TIMEOUT=30000
MAX_RETRIES=3
RECONNECT_DELAY=5000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎯 FEATURE FLAGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENABLE_COMMANDS=true
ENABLE_TELEGRAM=true
ENABLE_DATABASE=false

# ╔══════════════════════════════════════╗
# ║     ⚠️  SETUP INSTRUCTIONS           ║
# ╚══════════════════════════════════════╝
# 
# 1. TELEGRAM TOKEN:
#    - Go to https://t.me/BotFather
#    - Create a new bot
#    - Copy the token and paste above
#
# 2. OWNER NUMBER:
#    - Format: country_code + number (without + or -)
#    - Example: 2348012345678 (Nigeria)
#    - Example: 1234567890 (USA)
#
# 3. DATABASE (Optional):
#    - Get MongoDB URI from https://mongodb.com/cloud/atlas
#    - Set ENABLE_DATABASE=true to activate
#
# 4. MODES:
#    - public: Anyone can use commands
#    - private: Only owner can use commands
#
# 5. RUN:
#    - npm install
#    - npm start (production)
#    - npm run dev (development with nodemon)
